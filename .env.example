# wsc_alpha environment variables — EXAMPLE FILE.
#
# Copy to `.env` (untracked, see .gitignore) and fill in real values there.
# Never commit a file named `.env`, `.env.*` (other than this `.env.example`), or
# anything else containing a real token/credential.
#
# No real values are present in this file — every entry below is a name only.

# Arena API authentication. Exact required env var name(s) are NOT yet confirmed
# against real Arena API documentation — this is a placeholder name.
ARENA_API_TOKEN=

# Arena API base URL — not yet confirmed.
ARENA_API_BASE_URL=

# Optional: environment/mode selector once wsc_alpha.runtime exists.
# No live/paper mode is implemented yet — see src/wsc_alpha/runtime/__init__.py.
WSC_ALPHA_MODE=
